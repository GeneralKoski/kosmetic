{
  "name": "kosmetic",
  "displayName": "kosmetic",
  "description": "TOML linter and formatter: diagnostics, quick fixes and formatting from the kosmetic language server.",
  "version": "0.1.0",
  "publisher": "generalkoski",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/GeneralKoski/kosmetic.git",
    "directory": "editors/vscode"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters",
    "Formatters",
    "Programming Languages"
  ],
  "keywords": [
    "toml",
    "lint",
    "format",
    "cargo",
    "pyproject"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:toml"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "The kosmetic executable is started only in trusted workspaces.",
      "restrictedConfigurations": [
        "kosmetic.path"
      ]
    }
  },
  "contributes": {
    "languages": [
      {
        "id": "toml",
        "aliases": [
          "TOML",
          "toml"
        ],
        "extensions": [
          ".toml"
        ],
        "filenames": [
          "Cargo.lock",
          "poetry.lock",
          "uv.lock"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "toml",
        "scopeName": "source.toml",
        "path": "./syntaxes/toml.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "kosmetic",
      "properties": {
        "kosmetic.path": {
          "type": "string",
          "default": "kosmetic",
          "markdownDescription": "Path of the `kosmetic` executable. The server is started as `kosmetic lsp`. Install it with `cargo install kosmetic-cli`.",
          "scope": "machine"
        },
        "kosmetic.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces the messages between VS Code and the language server."
        }
      }
    },
    "commands": [
      {
        "command": "kosmetic.restartServer",
        "title": "kosmetic: Restart Language Server"
      }
    ]
  },
  "scripts": {
    "build": "esbuild src/extension.js --bundle --platform=node --format=cjs --external:vscode --minify --outfile=dist/extension.js",
    "vscode:prepublish": "npm run build",
    "package": "vsce package",
    "check": "node --check src/extension.js"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "@vscode/vsce": "^3.0.0"
  }
}
